# Server Port
PORT=5000

# Environment (development / production / test)
NODE_ENV=development

# MongoDB Connection String (Atlas URI or Local instance)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ccms_db?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=ccms_super_secret_jwt_key_2026_secure_complaint_portal
JWT_EXPIRES_IN=7d

# Allowed Frontend Client URL
CLIENT_URL=http://localhost:5173

# File Upload Settings
UPLOAD_PATH=uploads
MAX_FILE_SIZE=5242880
